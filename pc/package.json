{
  "name": "life-hub-pc",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@9.12.1",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "vue-tsc -b && vite build",
    "preview": "vite preview --host 0.0.0.0",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "test:e2e:business": "playwright test --config playwright.business.config.ts",
    "test:e2e:dev": "playwright test --config playwright.dev.config.ts",
    "test:e2e:live": "playwright test --config playwright.live.config.ts"
  },
  "dependencies": {
    "@lucide/vue": "^1.70.0",
    "axios": "^1.16.0",
    "echarts": "^6.0.0",
    "element-plus": "^2.11.8",
    "vue": "^3.5.13",
    "vue-router": "^4.5.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.56.1",
    "@types/node": "^22.10.0",
    "@vitejs/plugin-vue": "^5.2.1",
    "typescript": "~5.7.2",
    "unplugin-vue-components": "^0.28.0",
    "vite": "^6.0.5",
    "vitest": "^3.2.4",
    "vue-tsc": "^2.2.0"
  }
}
